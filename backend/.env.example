# Server Configuration
PORT=8000
ENVIRONMENT=development

# Database Configuration
# Leave blank for local zero-config SQLite (sqlite:///./agrismart.db)
# Or provide PostgreSQL URI for production (e.g. Render Postgres)
DATABASE_URL=sqlite:///./agrismart.db

# Google Gemini Pro Configuration
# Add your Gemini API Key here for Gemini Pro generated descriptions and cure plans
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# Optional Services
CORS_ORIGINS=["*"]
